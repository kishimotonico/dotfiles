#!/usr/bin/env bash
# herdr-at — 指定時刻/間隔でherdrペインにテキストを送る
#
# usage:
#   herdr-at [オプション] [--] [本文...]
#
#   -t, --target <terminal_id|pane_id>  宛先。省略時は herdr-pick で対話選択
#       --at <TIME>                     この時刻に送る。--every 併用時は開始時刻
#       --every <DUR>                   この間隔で繰り返す (例: 30m, 1h, 90s, 1h30m)
#       --skip-first                    --every 指定時、最初の1回を飛ばす
#       --times <N>                     N 回送ったら終了
#       --until <TIME>                  この時刻を過ぎたら終了
#       --no-enter                      テキストだけ送り Enter を押さない
#   -f, --file <FILE>                   本文をファイルから読む (- は標準入力)
#   -n, --dry-run                       送らずに宛先・予定時刻・本文を表示
#   -h, --help                          このヘルプを表示
#
# 本文は引数、-f FILE、標準入力(- またはパイプ)のいずれかで指定する。
# 本文を省略した場合は Enter のみを送る (--no-enter 指定時は何も送らない)。
# --at も --every も無ければ即時に1回送信する。
set -euo pipefail

usage() {
    sed -n '2,/^set -euo pipefail/p' "$0" | sed 's/^# \{0,1\}//; $d'
}

die() {
    echo "herdr-at: $*" >&2
    exit 1
}

herdr_pick_cmd() {
    local dir base pick
    if command -v herdr-pick >/dev/null 2>&1; then
        printf '%s\n' herdr-pick
        return
    fi
    dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
    base=$(basename "${BASH_SOURCE[0]}")
    if [[ "$base" == executable_* ]]; then
        pick="$dir/${base/herdr-at/herdr-pick}"
        if [ -x "$pick" ]; then
            printf '%s\n' "$pick"
            return
        fi
    fi
    die "herdr-pick not found"
}

# sleep-until と同じ時刻解釈。HH:MM 形式が過去なら翌日へ繰り越す
parse_time() {
    local spec="$1" now target
    now=$(date +%s)
    target=$(date -d "$spec" +%s 2>/dev/null) || die "時刻を解釈できません: $spec"

    if (( target <= now )); then
        if [[ "$spec" =~ ^[0-9]{1,2}:[0-9]{2}(:[0-9]{2})?([[:space:]]*(am|pm|AM|PM))?$ ]]; then
            target=$(date -d "tomorrow $spec" +%s)
        else
            die "指定時刻が過去です: $(date -d "@$target" '+%Y-%m-%d %H:%M:%S')"
        fi
    fi
    printf '%s\n' "$target"
}

parse_duration() {
    local dur total rest n
    dur="$1"
    total=0
    rest="$dur"

    if [[ "$dur" =~ ^[0-9]+$ ]]; then
        printf '%s\n' "$dur"
        return
    fi

    rest="$dur"
    while [ -n "$rest" ]; do
        if [[ "$rest" =~ ^([0-9]+)h(.*)$ ]]; then
            n="${BASH_REMATCH[1]}"
            total=$((total + n * 3600))
            rest="${BASH_REMATCH[2]}"
        elif [[ "$rest" =~ ^([0-9]+)m(.*)$ ]]; then
            n="${BASH_REMATCH[1]}"
            total=$((total + n * 60))
            rest="${BASH_REMATCH[2]}"
        elif [[ "$rest" =~ ^([0-9]+)s(.*)$ ]]; then
            n="${BASH_REMATCH[1]}"
            total=$((total + n))
            rest="${BASH_REMATCH[2]}"
        else
            die "間隔を解釈できません: $dur"
        fi
    done

    (( total > 0 )) || die "間隔を解釈できません: $dur"
    printf '%s\n' "$total"
}

format_ts() {
    date -d "@$1" '+%Y-%m-%d %H:%M:%S'
}

# herdr-msg の agent_info() と同じ
agent_info() {
    local target="$1" response message matches count
    case "$target" in
        term_*)
            if ! response=$(herdr agent list 2>&1); then
                message=$(jq -r '.error.message // empty' <<<"$response" 2>/dev/null || true)
                die "${message:-failed to list agents}"
            fi
            matches=$(jq -c --arg t "$target" '.result.agents[] | select(.terminal_id == $t)' <<<"$response")
            [ -n "$matches" ] || return 1
            count=$(wc -l <<<"$matches")
            [ "$count" -eq 1 ] || die "multiple agents found for terminal_id $target"
            printf '%s\n' "$matches"
            ;;
        *)
            if ! response=$(herdr agent get "$target" 2>&1); then
                return 1
            fi
            jq -ec '.result.agent' <<<"$response"
            ;;
    esac
}

normalize_target() {
    local target="$1" response terminal
    case "$target" in
        term_*)
            printf '%s\n' "$target"
            ;;
        *:p*)
            if ! response=$(herdr pane list 2>&1); then
                message=$(jq -r '.error.message // empty' <<<"$response" 2>/dev/null || true)
                die "${message:-failed to list panes}"
            fi
            terminal=$(jq -r --arg p "$target" '.result.panes[] | select(.pane_id == $p) | .terminal_id' <<<"$response")
            [ -n "$terminal" ] || die "pane not found: $target"
            printf '%s\n' "$terminal"
            ;;
        *)
            die "invalid target: $target (expected terminal_id or pane_id)"
            ;;
    esac
}

resolve_pane_id() {
    local terminal_id="$1" response pane
    if ! response=$(herdr pane list 2>&1); then
        message=$(jq -r '.error.message // empty' <<<"$response" 2>/dev/null || true)
        die "${message:-failed to list panes}"
    fi
    pane=$(jq -r --arg t "$terminal_id" '.result.panes[] | select(.terminal_id == $t) | .pane_id' <<<"$response")
    [ -n "$pane" ] || die "pane not found for $terminal_id (may have been closed)"
    printf '%s\n' "$pane"
}

wait_until() {
    local target="$1" remain h m s
    while :; do
        remain=$((target - $(date +%s)))
        (( remain <= 0 )) && break
        h=$((remain / 3600))
        m=$(((remain % 3600) / 60))
        s=$((remain % 60))
        if [ -t 2 ]; then
            printf '\rherdr-at: %s まで待機 (残り %dh%02dm%02ds)   ' "$(format_ts "$target")" "$h" "$m" "$s" >&2
        else
            printf 'herdr-at: %s まで待機 (残り %dh%02dm%02ds)\n' "$(format_ts "$target")" "$h" "$m" "$s" >&2
        fi
        sleep $((remain > 60 ? 60 : remain))
    done
    [ -t 2 ] && printf '\n' >&2 || true
}

send_to_pane() {
    local terminal_id="$1" text="$2" no_enter="$3"
    local pane info status is_agent=0

    pane=$(resolve_pane_id "$terminal_id")

    if info=$(agent_info "$terminal_id" 2>/dev/null); then
        is_agent=1
        status=$(jq -r '.agent_status' <<<"$info")
    fi

    if [ "$is_agent" -eq 1 ]; then
        if [ -z "$text" ] && [ "$no_enter" -eq 0 ]; then
            herdr pane send-keys "$pane" enter >/dev/null
        elif [ "$no_enter" -eq 1 ]; then
            if [ -n "$text" ]; then
                herdr pane send-text "$pane" "$text" >/dev/null
            fi
        elif [ "$status" = "working" ]; then
            herdr agent prompt "$pane" "$text" >/dev/null
        elif ! herdr agent prompt "$pane" "$text" --wait --until working --timeout 8000 >/dev/null 2>&1; then
            herdr pane send-keys "$pane" enter >/dev/null 2>&1 || true
            herdr agent wait "$pane" --until working --timeout 3000 >/dev/null 2>&1 ||
                die "could not confirm submit for $pane. check with 'herdr pane read $pane'; if text remains in the composer, run 'herdr pane send-keys $pane enter'"
        fi
    else
        if [ -n "$text" ]; then
            herdr pane send-text "$pane" "$text" >/dev/null
        fi
        if [ "$no_enter" -eq 0 ]; then
            herdr pane send-keys "$pane" enter >/dev/null
        fi
    fi
}

body_preview() {
    local text="$1"
    if [ -z "$text" ]; then
        if [ "$no_enter" -eq 1 ]; then
            printf '(empty, no-enter)\n'
        else
            printf '(enter only)\n'
        fi
        return
    fi
    if [[ "$text" == *$'\n'* ]]; then
        printf '%s\n' "$text" | sed 's/^/  | /'
    else
        printf '%s\n' "$text"
    fi
}

target=""
at_spec=""
every_spec=""
skip_first=0
times=""
until_spec=""
no_enter=0
file=""
dry_run=0
body=""
body_from_args=0

while [ $# -gt 0 ]; do
    case "$1" in
        -t|--target)
            [ $# -ge 2 ] || die "option $1 requires an argument"
            target="$2"
            shift 2
            ;;
        --at)
            [ $# -ge 2 ] || die "option $1 requires an argument"
            at_spec="$2"
            shift 2
            ;;
        --every)
            [ $# -ge 2 ] || die "option $1 requires an argument"
            every_spec="$2"
            shift 2
            ;;
        --skip-first)
            skip_first=1
            shift
            ;;
        --times)
            [ $# -ge 2 ] || die "option $1 requires an argument"
            times="$2"
            shift 2
            ;;
        --until)
            [ $# -ge 2 ] || die "option $1 requires an argument"
            until_spec="$2"
            shift 2
            ;;
        --no-enter)
            no_enter=1
            shift
            ;;
        -f|--file)
            [ $# -ge 2 ] || die "option $1 requires an argument"
            file="$2"
            shift 2
            ;;
        -n|--dry-run)
            dry_run=1
            shift
            ;;
        -h|--help|help)
            usage
            exit 0
            ;;
        --)
            shift
            body_from_args=1
            break
            ;;
        -*)
            die "unknown option: $1 (try --help)"
            ;;
        *)
            body_from_args=1
            break
            ;;
    esac
done

if [ "$body_from_args" -eq 1 ]; then
    body="$*"
elif [ -n "$file" ]; then
    if [ "$file" = "-" ]; then
        body=$(cat)
    else
        [ -f "$file" ] || die "file not found: $file"
        body=$(<"$file")
    fi
elif [ -p /dev/stdin ]; then
    # パイプで渡されたときだけ読む。単なる非tty (バックグラウンド実行や
    # < /dev/null) で本文入力待ちにならないようにする
    body=$(cat)
fi

if [ -n "$times" ]; then
    [[ "$times" =~ ^[0-9]+$ ]] || die "--times must be a positive integer"
    [ "$times" -gt 0 ] || die "--times must be at least 1"
fi

every_secs=""
[ -z "$every_spec" ] || every_secs=$(parse_duration "$every_spec")

until_ts=""
[ -z "$until_spec" ] || until_ts=$(parse_time "$until_spec")

if [ -z "$target" ]; then
    pick_cmd=$(herdr_pick_cmd)
    target=$("$pick_cmd") || exit $?
fi
terminal_id=$(normalize_target "$target")

send_count=0
trap 'printf "herdr-at: interrupted after %d send(s)\n" "$send_count" >&2; exit 130' INT

now=$(date +%s)
if [ -n "$at_spec" ]; then
    next_target=$(parse_time "$at_spec")
elif [ -n "$every_secs" ]; then
    next_target=$now
else
    next_target=$now
fi

if [ -n "$every_secs" ] && [ "$skip_first" -eq 1 ]; then
    if [ -n "$at_spec" ]; then
        next_target=$((next_target + every_secs))
    else
        next_target=$((now + every_secs))
    fi
fi

# dry-run は待機しないので、--times も --until も無い繰り返しは無限に出力される。
# 予定が長いときも読みづらいので、先頭だけ見せて打ち切る
dry_run_max=10

while :; do
    # 次の送信予定が期限を過ぎているなら、待たずに終了する
    if [ -n "$until_ts" ] && [ "$next_target" -gt "$until_ts" ]; then
        break
    fi

    if [ "$dry_run" -eq 1 ] && [ "$send_count" -ge "$dry_run_max" ]; then
        printf 'herdr-at: (先頭 %d 件のみ表示。以降省略)\n' "$dry_run_max" >&2
        break
    fi

    if [ "$next_target" -gt "$(date +%s)" ] && [ "$dry_run" -eq 0 ]; then
        wait_until "$next_target"
    fi

    pane_id=$(resolve_pane_id "$terminal_id")

    if [ "$dry_run" -eq 1 ]; then
        printf 'herdr-at: dry-run send #%d\n' "$((send_count + 1))" >&2
        printf '  target:   %s (pane %s)\n' "$terminal_id" "$pane_id" >&2
        printf '  at:       %s\n' "$(format_ts "$next_target")" >&2
        printf '  body:\n' >&2
        body_preview "$body" >&2
    else
        send_to_pane "$terminal_id" "$body" "$no_enter"
        printf 'herdr-at: sent to %s (pane %s) at %s\n' "$terminal_id" "$pane_id" "$(format_ts "$next_target")" >&2
    fi

    send_count=$((send_count + 1))

    if [ -n "$times" ] && [ "$send_count" -ge "$times" ]; then
        break
    fi

    [ -n "$every_secs" ] || break

    next_target=$((next_target + every_secs))
    now=$(date +%s)
    while (( next_target <= now )); do
        next_target=$((next_target + every_secs))
    done
done

if [ "$dry_run" -eq 1 ]; then
    printf 'herdr-at: dry-run complete (%d send(s) planned)\n' "$send_count" >&2
fi
