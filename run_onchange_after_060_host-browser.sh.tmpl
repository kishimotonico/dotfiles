{{- if .isWsl -}}
#!/bin/bash
#
# xdg-open で開くURLを Windows の既定ブラウザ (host-browser.desktop) にする。
# WSL内のLinux版Chromeが既定だと、xdg-open を使うCLIの認証画面がそちらで開いてしまうため。
# desktop: {{ include "dot_local/share/applications/host-browser.desktop" | sha256sum }}

set -eu

if ! command -v xdg-mime >/dev/null 2>&1; then
    echo "host-browser: xdg-mime unavailable; skipping" >&2
    exit 0
fi

# rundll32.exe はLinuxのファイルパスを開けないため、URLスキームだけを割り当てる
for mime in x-scheme-handler/http x-scheme-handler/https; do
    xdg-mime default host-browser.desktop "$mime"
done
echo "host-browser: http/https handler set to host-browser.desktop"
{{- end }}
